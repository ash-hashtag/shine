# Cloudflare static assets headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro's bundled files have content hashes in their names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The app's files are loaded with a hash of their contents in the URL
# (?v=…, see src/pages/app.astro), so each version can be kept for good.
/pkg/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=86400
