---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const module = `${base}pkg/shine.js`;
---

<Base
  title="Shine - Photonic Circuit Simulator"
  description="The Shine photonic circuit editor, running in your browser. Lay out free-space optics or wire waveguide schematics and simulate them live."
  noindex
>
  <canvas id="shine" aria-label="Shine editor"></canvas>
  <div id="status" role="status">
    <strong>Loading Shine…</strong>
    <span>Downloading the simulator. This takes a moment the first time.</span>
  </div>
  <noscript>
    <div id="noscript">Shine runs as a WebAssembly app and needs JavaScript enabled.</div>
  </noscript>
  <script type="module" define:vars={{ module, home: base }}>
    const status = document.getElementById("status");
    const canvas = document.getElementById("shine");
    let failed = false;

    // Anything that stops the app is shown here, never a silent blank page.
    function fatal(title, detail) {
      if (failed) return;
      failed = true;
      console.error(title, detail);
      status.replaceChildren();
      const heading = document.createElement("strong");
      heading.textContent = title;
      const help = document.createElement("span");
      help.textContent = "Reload to try again. If it keeps happening, the details below help us fix it.";
      const pre = document.createElement("pre");
      pre.textContent = `${detail}\n\n${navigator.userAgent}\nrenderer=${new URLSearchParams(location.search).get("renderer") ?? "webgl"}`;
      const actions = document.createElement("div");
      actions.className = "actions";
      const reload = document.createElement("button");
      reload.textContent = "Reload";
      reload.onclick = () => location.reload();
      const back = document.createElement("a");
      back.href = home;
      back.textContent = "Home page";
      actions.append(reload, back);
      status.append(heading, help, pre, actions);
      status.classList.remove("hidden");
    }
    window.shineFatal = (message) => fatal("Shine crashed", message);
    window.addEventListener("error", (e) => fatal("Shine hit an error", e.error?.stack ?? e.message));
    window.addEventListener("unhandledrejection", (e) => fatal("Shine hit an error", e.reason?.stack ?? String(e.reason)));
    canvas.addEventListener("webglcontextlost", () =>
      fatal("Graphics stopped", "The browser lost the WebGL context, usually after a GPU driver reset or running out of GPU memory."),
    );

    try {
      const { default: init, start } = await import(module);
      await init();
      await start("shine", location.search);
      if (!failed) status.classList.add("hidden");
      const example = new URLSearchParams(location.search).get("example");
      document.title = example ? `${example.replaceAll("-", " ")} · Shine - Photonic Circuit Simulator` : "Shine - Photonic Circuit Simulator";
    } catch (error) {
      const webgl2 = !!document.createElement("canvas").getContext("webgl2");
      fatal(
        "Shine could not start",
        `${error?.stack ?? error}${webgl2 ? "" : "\n\nThis browser has no WebGL 2 support, which Shine needs."}`,
      );
    }
  </script>
</Base>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }
  #shine {
    display: block;
    width: 100%;
    height: 100%;
  }
  #status,
  #noscript {
    position: fixed;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 8px;
    text-align: center;
    color: var(--muted);
    background: var(--bg);
  }
  #status.hidden {
    display: none;
  }
  #status strong {
    color: var(--text);
    font-size: 18px;
  }
  #status pre {
    max-width: min(720px, 90vw);
    max-height: 40vh;
    overflow: auto;
    text-align: left;
    white-space: pre-wrap;
    margin: 8px auto 0;
  }
  #status .actions {
    justify-content: center;
    align-items: center;
  }
  #status button {
    font: inherit;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
</style>
