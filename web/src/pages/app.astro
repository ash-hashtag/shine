---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const module = `${base}pkg/shine.js`;
---

<Base
  title="Shine · editor"
  description="The Shine photonic circuit editor, running in your browser. Lay out free-space optics or wire waveguide schematics and simulate them live."
  noindex
>
  <canvas id="shine" aria-label="Shine editor"></canvas>
  <div id="status" role="status">
    <strong>Loading Shine…</strong>
    <span>Downloading the simulator. This takes a moment the first time.</span>
  </div>
  <noscript>
    <div id="noscript">Shine runs as a WebAssembly app and needs JavaScript enabled.</div>
  </noscript>
  <script type="module" define:vars={{ module, home: base }}>
    const status = document.getElementById("status");
    try {
      const { default: init, start } = await import(module);
      await init();
      const example = new URLSearchParams(location.search).get("example");
      await start("shine", location.search);
      status.classList.add("hidden");
      document.title = example ? `Shine · ${example.replaceAll("-", " ")}` : "Shine";
    } catch (error) {
      console.error(error);
      status.innerHTML =
        "<strong>Shine could not start</strong>" +
        "<span>Your browser needs WebGL 2 and WebAssembly. " +
        `Details are in the developer console. <a href="${home}">Back to the home page</a></span>`;
    }
  </script>
</Base>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }
  #shine {
    display: block;
    width: 100%;
    height: 100%;
  }
  #status,
  #noscript {
    position: fixed;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 8px;
    text-align: center;
    color: var(--muted);
    background: var(--bg);
  }
  #status.hidden {
    display: none;
  }
  #status strong {
    color: var(--text);
    font-size: 18px;
  }
</style>
