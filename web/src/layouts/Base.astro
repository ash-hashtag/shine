---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Social preview image, relative to the site root. */
  image?: string;
  imageAlt?: string;
  /** Keep the page out of search results (it still passes on links). */
  noindex?: boolean;
  /** `article` for documentation pages, `website` otherwise. */
  type?: "website" | "article";
  /** ISO date the page's content last changed. */
  modified?: string;
  /** schema.org objects, emitted as one JSON-LD graph. */
  structuredData?: object[];
  /** The page has no address of its own (the 404 page is served anywhere). */
  addressless?: boolean;
}

const {
  title,
  description,
  image = "screenshots/og.webp",
  imageAlt = "Shine: design photonic circuits and watch the light.",
  noindex = false,
  addressless = false,
  type = "website",
  modified,
  structuredData = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
// Absolute URLs need the public address (SITE_URL at build time).
const site = Astro.site;
const pageUrl = site && !addressless ? new URL(Astro.url.pathname, site).href : undefined;
// A canonical link on a noindex page would send search engines mixed signals.
const canonical = noindex ? undefined : pageUrl;
const imageUrl = site ? new URL(`${base}${image}`, site).href : `${base}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />

    <meta name="application-name" content="Shine" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17181b" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="alternate" type="text/plain" title="Shine documentation for language models" href={`${base}llms.txt`} />
    {site && <link rel="sitemap" href={`${base}sitemap.xml`} />}

    <meta property="og:type" content={type} />
    {type === "article" && modified && <meta property="article:modified_time" content={modified} />}
    <meta property="og:site_name" content="Shine" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {structuredData.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": structuredData })} />
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
